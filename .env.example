# ---- Azure AI Search ----
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_API_KEY=<your-search-admin-key>
AZURE_SEARCH_INDEX_NAME=sgs-docs

# ---- Azure OpenAI ----
AZURE_OPENAI_ENDPOINT=https://<your-openai-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=<your-openai-key>
AZURE_OPENAI_API_VERSION=2024-10-21

# Deployment names (as created in Azure OpenAI Studio), not raw model names
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.1

# ---- Azure AI Foundry (Default "Foundry IQ" mode: agent + knowledge base) ----
# Auth is Azure AD via `az login` (DefaultAzureCredential); no key needed.
FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry-resource>.services.ai.azure.com/
FOUNDRY_PROJECT_NAME=<your-foundry-project>
FOUNDRY_AGENT_NAME=sgs-knowledge-agent
FOUNDRY_KNOWLEDGE_BASE_NAME=sgs-knowledge-base

# ---- Pipeline mode: custom | foundry_iq (UI overrides per session) ----
RAG_MODE=custom

# ---- Azure AI Speech (voice input/output) ----
# Leave SPEECH_API_KEY blank to reuse AZURE_OPENAI_API_KEY (multi-service AIServices).
SPEECH_REGION=eastus
SPEECH_API_KEY=
SPEECH_VOICE=en-US-AvaMultilingualNeural

# ---- Agent avatar (Azure real-time TTS Avatar) ----
# Opt-in talking-head that speaks the answer (reuses SPEECH_REGION + key/voice).
# Off by default because the real-time avatar bills per minute. SPEECH_REGION must
# support real-time avatar (e.g. eastus, eastus2, westus2, westeurope, swedencentral).
AVATAR_ENABLED=false
AVATAR_CHARACTER=lisa
AVATAR_STYLE=casual-sitting

# ---- Voice streaming backend (FastAPI SSE service for concurrent TTS) ----
VOICE_BACKEND_URL=http://localhost:8000
VOICE_BACKEND_HOST=localhost
VOICE_BACKEND_PORT=8000

# ---- Chunking (measured in TOKENS) ----
CHUNK_SIZE=512
CHUNK_OVERLAP=128

# ---- Retrieval / generation ----
TOP_K=5
# Relevance gate — min semantic reranker score (0-4) to use a chunk / answer at all
RERANKER_THRESHOLD=1.8
CHAT_TEMPERATURE=0.0
CHAT_MAX_TOKENS=800

# ---- Local document folders (comma-separated, relative to project root) ----
# Seed docs live in the repo; uploads go to custom_docs/
DOCS_DIRS=.,General_Conditions,custom_docs
CUSTOM_DOCS_DIR=custom_docs

# ---- Evaluation (LLM-as-judge) ----
# The eval SDK asks reasoning-model judges (gpt-5 / o-series) for up to 60000 completion
# tokens, which blows past tight per-minute quotas (e.g. gpt-5-1's 10K TPM) and 429s.
# Cap it lower, and retry on 429 with backoff so a transient rate limit doesn't abort.
EVAL_JUDGE_MAX_COMPLETION_TOKENS=8000
EVAL_RETRY_MAX=5
EVAL_RETRY_WAIT=15.0
