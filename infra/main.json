{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.46.1.21595",
      "templateHash": "2182448768191265450"
    }
  },
  "parameters": {
    "environmentName": {
      "type": "string",
      "metadata": {
        "description": "Short name used as a prefix for all resource names (e.g. \"sgs-rag\")."
      }
    },
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Azure region for all resources."
      }
    },
    "chatModelName": {
      "type": "string",
      "defaultValue": "gpt-4o-mini",
      "metadata": {
        "description": "Chat model to deploy (deployment name = model name)."
      }
    },
    "chatModelVersion": {
      "type": "string",
      "defaultValue": "2024-07-18",
      "metadata": {
        "description": "Chat model version."
      }
    },
    "chatSku": {
      "type": "string",
      "defaultValue": "Standard",
      "metadata": {
        "description": "Chat deployment SKU name. Regional \"Standard\" avoids the Azure OpenAI \"unusual activity\" guard that can block GlobalStandard on some accounts."
      }
    },
    "chatCapacity": {
      "type": "int",
      "defaultValue": 20,
      "metadata": {
        "description": "Chat deployment capacity (TPM / 1000)."
      }
    },
    "embeddingModelName": {
      "type": "string",
      "defaultValue": "text-embedding-3-small",
      "metadata": {
        "description": "Embedding model to deploy (deployment name = model name)."
      }
    },
    "embeddingModelVersion": {
      "type": "string",
      "defaultValue": "1",
      "metadata": {
        "description": "Embedding model version."
      }
    },
    "embeddingSku": {
      "type": "string",
      "defaultValue": "Standard",
      "metadata": {
        "description": "Embedding deployment SKU name."
      }
    },
    "embeddingCapacity": {
      "type": "int",
      "defaultValue": 50,
      "metadata": {
        "description": "Embedding deployment capacity (TPM / 1000)."
      }
    },
    "searchSku": {
      "type": "string",
      "defaultValue": "basic",
      "allowedValues": [
        "free",
        "basic",
        "standard",
        "standard2",
        "standard3"
      ],
      "metadata": {
        "description": "Azure AI Search SKU. basic/standard support vector + hybrid search."
      }
    },
    "searchIndexName": {
      "type": "string",
      "defaultValue": "sgs-docs",
      "metadata": {
        "description": "Name of the search index the app creates/uses."
      }
    }
  },
  "variables": {
    "prefix": "[toLower(parameters('environmentName'))]",
    "suffix": "[take(uniqueString(resourceGroup().id), 6)]",
    "tags": {
      "environment": "[parameters('environmentName')]",
      "project": "sgs-rag-poc"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "openai",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[format('{0}-openai-{1}', variables('prefix'), variables('suffix'))]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          },
          "chatModelName": {
            "value": "[parameters('chatModelName')]"
          },
          "chatModelVersion": {
            "value": "[parameters('chatModelVersion')]"
          },
          "chatSku": {
            "value": "[parameters('chatSku')]"
          },
          "chatCapacity": {
            "value": "[parameters('chatCapacity')]"
          },
          "embeddingModelName": {
            "value": "[parameters('embeddingModelName')]"
          },
          "embeddingModelVersion": {
            "value": "[parameters('embeddingModelVersion')]"
          },
          "embeddingSku": {
            "value": "[parameters('embeddingSku')]"
          },
          "embeddingCapacity": {
            "value": "[parameters('embeddingCapacity')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
              "templateHash": "12965585832299425377"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "Azure OpenAI (Cognitive Services) account name — becomes the *.openai.azure.com subdomain."
              }
            },
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object"
            },
            "chatModelName": {
              "type": "string"
            },
            "chatModelVersion": {
              "type": "string"
            },
            "chatSku": {
              "type": "string"
            },
            "chatCapacity": {
              "type": "int"
            },
            "embeddingModelName": {
              "type": "string"
            },
            "embeddingModelVersion": {
              "type": "string"
            },
            "embeddingSku": {
              "type": "string"
            },
            "embeddingCapacity": {
              "type": "int"
            }
          },
          "resources": [
            {
              "type": "Microsoft.CognitiveServices/accounts",
              "apiVersion": "2024-10-01",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "kind": "OpenAI",
              "sku": {
                "name": "S0"
              },
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "customSubDomainName": "[parameters('name')]",
                "publicNetworkAccess": "Enabled",
                "disableLocalAuth": false
              }
            },
            {
              "type": "Microsoft.CognitiveServices/accounts/deployments",
              "apiVersion": "2024-10-01",
              "name": "[format('{0}/{1}', parameters('name'), parameters('embeddingModelName'))]",
              "sku": {
                "name": "[parameters('embeddingSku')]",
                "capacity": "[parameters('embeddingCapacity')]"
              },
              "properties": {
                "model": {
                  "format": "OpenAI",
                  "name": "[parameters('embeddingModelName')]",
                  "version": "[parameters('embeddingModelVersion')]"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.CognitiveServices/accounts', parameters('name'))]"
              ]
            },
            {
              "type": "Microsoft.CognitiveServices/accounts/deployments",
              "apiVersion": "2024-10-01",
              "name": "[format('{0}/{1}', parameters('name'), parameters('chatModelName'))]",
              "sku": {
                "name": "[parameters('chatSku')]",
                "capacity": "[parameters('chatCapacity')]"
              },
              "properties": {
                "model": {
                  "format": "OpenAI",
                  "name": "[parameters('chatModelName')]",
                  "version": "[parameters('chatModelVersion')]"
                }
              },
              "dependsOn": [
                "[resourceId('Microsoft.CognitiveServices/accounts', parameters('name'))]",
                "[resourceId('Microsoft.CognitiveServices/accounts/deployments', parameters('name'), parameters('embeddingModelName'))]"
              ]
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "value": "[resourceId('Microsoft.CognitiveServices/accounts', parameters('name'))]"
            },
            "name": {
              "type": "string",
              "value": "[parameters('name')]"
            },
            "endpoint": {
              "type": "string",
              "value": "[reference(resourceId('Microsoft.CognitiveServices/accounts', parameters('name')), '2024-10-01').endpoint]"
            },
            "chatDeploymentName": {
              "type": "string",
              "value": "[parameters('chatModelName')]"
            },
            "embeddingDeploymentName": {
              "type": "string",
              "value": "[parameters('embeddingModelName')]"
            }
          }
        }
      }
    },
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2025-04-01",
      "name": "search",
      "properties": {
        "expressionEvaluationOptions": {
          "scope": "inner"
        },
        "mode": "Incremental",
        "parameters": {
          "name": {
            "value": "[format('{0}-search-{1}', variables('prefix'), variables('suffix'))]"
          },
          "location": {
            "value": "[parameters('location')]"
          },
          "tags": {
            "value": "[variables('tags')]"
          },
          "sku": {
            "value": "[parameters('searchSku')]"
          }
        },
        "template": {
          "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
          "contentVersion": "1.0.0.0",
          "metadata": {
            "_generator": {
              "name": "bicep",
              "version": "0.46.1.21595",
              "templateHash": "10403643728544065128"
            }
          },
          "parameters": {
            "name": {
              "type": "string",
              "metadata": {
                "description": "Azure AI Search service name — becomes the *.search.windows.net subdomain."
              }
            },
            "location": {
              "type": "string"
            },
            "tags": {
              "type": "object"
            },
            "sku": {
              "type": "string",
              "metadata": {
                "description": "Service SKU. basic/standard support vector + hybrid search."
              }
            }
          },
          "resources": [
            {
              "type": "Microsoft.Search/searchServices",
              "apiVersion": "2024-06-01-preview",
              "name": "[parameters('name')]",
              "location": "[parameters('location')]",
              "tags": "[parameters('tags')]",
              "sku": {
                "name": "[parameters('sku')]"
              },
              "identity": {
                "type": "SystemAssigned"
              },
              "properties": {
                "replicaCount": 1,
                "partitionCount": 1,
                "hostingMode": "default",
                "publicNetworkAccess": "enabled",
                "authOptions": {
                  "aadOrApiKey": {
                    "aadAuthFailureMode": "http401WithBearerChallenge"
                  }
                }
              }
            }
          ],
          "outputs": {
            "id": {
              "type": "string",
              "value": "[resourceId('Microsoft.Search/searchServices', parameters('name'))]"
            },
            "name": {
              "type": "string",
              "value": "[parameters('name')]"
            },
            "endpoint": {
              "type": "string",
              "value": "[format('https://{0}.search.windows.net', parameters('name'))]"
            }
          }
        }
      }
    }
  ],
  "outputs": {
    "AZURE_OPENAI_ENDPOINT": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'openai'), '2025-04-01').outputs.endpoint.value]"
    },
    "AZURE_OPENAI_ACCOUNT_NAME": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'openai'), '2025-04-01').outputs.name.value]"
    },
    "AZURE_OPENAI_CHAT_DEPLOYMENT": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'openai'), '2025-04-01').outputs.chatDeploymentName.value]"
    },
    "AZURE_OPENAI_EMBEDDING_DEPLOYMENT": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'openai'), '2025-04-01').outputs.embeddingDeploymentName.value]"
    },
    "AZURE_SEARCH_ENDPOINT": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'search'), '2025-04-01').outputs.endpoint.value]"
    },
    "AZURE_SEARCH_SERVICE_NAME": {
      "type": "string",
      "value": "[reference(resourceId('Microsoft.Resources/deployments', 'search'), '2025-04-01').outputs.name.value]"
    },
    "AZURE_SEARCH_INDEX_NAME": {
      "type": "string",
      "value": "[parameters('searchIndexName')]"
    }
  }
}